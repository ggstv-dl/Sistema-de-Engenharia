# Variáveis de ambiente do CRM Engineer Civil

# Porta do servidor
PORT=3000

# URL de conexão com o PostgreSQL
DATABASE_URL="postgresql://localhost:5432/crm_engineer_civil?schema=public"

# Segredo para JWT (gerar uma chave longa e aleatória)
JWT_SECRET=sua-chave-secreta-aqui

# Tempo de expiração do JWT
JWT_EXPIRES_IN=24h

# Chave da API do WhatsApp (para envio de orçamentos)
WHATSAPP_API_KEY=sua-chave-api-whatsapp

# Número de WhatsApp remetente (formato internacional)
WHATSAPP_FROM_NUMBER=+5511999999999